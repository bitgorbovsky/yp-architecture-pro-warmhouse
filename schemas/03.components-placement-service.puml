@startuml
!include <C4/C4_Component>
!include <C4/C4_Context>

HIDE_STEREOTYPE()


Boundary(DevicesPlacement, "Размещение приборов") {
    Component(PlacementsCRUDController, "PlacementsCRUDController",\
              $descr="Создание и получение записей по размещениям")

    Component(PlacementsModel, "PlacementsModel")

}

Person(user, "Пользователь")

Boundary(clientApps, "Клиентские приложения") {
    System(clientMobileApp, "Мобильное приложение", $type="Android, iOS, Aurora")
    System(clientWebApp, "Web-приложение", $type="Web($mol)")
}
Rel(user, clientMobileApp, "")
Rel(user, clientWebApp, "")

ComponentDb_Ext(PlacementsDb, "База данных размещений")
Rel(PlacementsCRUDController, PlacementsModel, "Хранение данных")
Rel(PlacementsModel, PlacementsDb, "Хранение данных")
Rel(clientMobileApp, PlacementsCRUDController, "Управление размещениями", "HTTPS")
Rel(clientWebApp, PlacementsCRUDController, "Управление размещениями", "HTTPS")

@enduml
